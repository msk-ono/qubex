 logger = logging.getLogger(__name__)
 
 
+_TIMING_DIAGNOSTIC_ENVS: Final[tuple[str, ...]] = (
+    "E7AWGHAL_TIMING_DIAGNOSTICS",
+    "QXDRIVER_QUEL1_TIMING_DIAGNOSTICS",
+    "QUEL_IC_CONFIG_TIMING_DIAGNOSTICS",
+)
+_TIMING_SLOW_THRESHOLD_ENV: Final[str] = "E7AWGHAL_TIMING_SLOW_MS"
+_DEFAULT_TIMING_SLOW_THRESHOLD_MS: Final[float] = 5.0
+
+
+def _timing_diagnostics_enabled() -> bool:
+    for env_name in _TIMING_DIAGNOSTIC_ENVS:
+        value = os.getenv(env_name, "")
+        if value.strip().lower() in {"1", "true", "yes", "on"}:
+            return True
+    return False
+
+
+def _timing_slow_threshold_ms() -> float:
+    value = os.getenv(_TIMING_SLOW_THRESHOLD_ENV, "")
+    if not value:
+        return _DEFAULT_TIMING_SLOW_THRESHOLD_MS
+    try:
+        threshold_ms = float(value)
+    except ValueError:
+        return _DEFAULT_TIMING_SLOW_THRESHOLD_MS
+    return max(0.0, threshold_ms)
+
+
+def _format_timing_value(value: object) -> str:
+    if isinstance(value, float):
+        return f"{value:.3f}"
+    if isinstance(value, (bool, int, str)):
+        return str(value)
+    return repr(value)
+
+
+def _log_e7awghal_timing_event(
+    event: str,
+    *,
+    phase: str,
+    threshold_ms: float,
+    elapsed_ms: float,
+    **fields: object,
+) -> None:
+    if not _timing_diagnostics_enabled():
+        return
+    lock_wait_ms = fields.get("lock_wait_ms")
+    recvfrom_ms = fields.get("recvfrom_ms")
+    if (
+        phase == "end"
+        and elapsed_ms < threshold_ms
+        and not (isinstance(lock_wait_ms, float) and lock_wait_ms >= threshold_ms)
+        and not (isinstance(recvfrom_ms, float) and recvfrom_ms >= threshold_ms)
+    ):
+        return
+
+    parts = [
+        "e7awghal_timing",
+        f"event={event}",
+        f"phase={phase}",
+        f"elapsed_ms={elapsed_ms:.3f}",
+    ]
+    for key in sorted(fields):
+        value = fields[key]
+        if value is not None:
+            parts.append(f"{key}={_format_timing_value(value)}")
+    logger.info(" ".join(parts))
+
+
