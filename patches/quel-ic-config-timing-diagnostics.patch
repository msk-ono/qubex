@@ -0,0 +1,149 @@
+"""Opt-in timing diagnostics for quel_ic_config wave scheduling."""
+
+from __future__ import annotations
+
+import os
+import time
+from logging import Logger
+from typing import Any, Callable, Optional, Tuple, TypeVar
+
+_DIAGNOSTICS_ENVS = (
+    "QUEL_IC_CONFIG_TIMING_DIAGNOSTICS",
+    "QXDRIVER_QUEL1_TIMING_DIAGNOSTICS",
+)
+_FALLBACK_TICK_SECONDS = 8e-9
+
+T = TypeVar("T")
+
+
+def diagnostics_enabled() -> bool:
+    """Return True when quel_ic_config timing diagnostics are enabled."""
+    for env_name in _DIAGNOSTICS_ENVS:
+        value = os.getenv(env_name, "")
+        if value.strip().lower() in {"1", "true", "yes", "on"}:
+            return True
+    return False
+
+
+def _read_current_timecounter(clkctrl: Any) -> Tuple[Optional[int], Optional[str]]:
+    reader = getattr(clkctrl, "read_counter", None)
+    if reader is None:
+        return None, "clock controller has no read_counter"
+    try:
+        value = reader()
+        if isinstance(value, tuple):
+            value = value[0]
+        return int(value), None
+    except Exception as exc:  # pragma: no cover - diagnostics only
+        return None, f"{type(exc).__name__}: {exc}"
+
+
+def _timecounter_delta_ms(clkctrl: Any, delta: int) -> float:
+    frequency = getattr(clkctrl, "CLOCK_FREQUENCY", None)
+    if frequency:
+        return delta / float(frequency) * 1000.0
+    return delta * _FALLBACK_TICK_SECONDS * 1000.0
+
+
+def _format_value(value: Any) -> str:
+    if isinstance(value, float):
+        return f"{value:.3f}"
+    if isinstance(value, (bool, int, str)):
+        return str(value)
+    return repr(value)
+
+
+def log_timing_event(
+    logger: Logger,
+    event: str,
+    *,
+    clkctrl: Any = None,
+    timecounter: Optional[int] = None,
+    current_timecounter: Optional[int] = None,
+    elapsed_ms: Optional[float] = None,
+    **fields: Any,
+) -> None:
+    """Log one timing diagnostic event when diagnostics are enabled."""
+    if not diagnostics_enabled():
+        return
+
+    current_error = None
+    if clkctrl is not None and timecounter is not None and current_timecounter is None:
+        current_timecounter, current_error = _read_current_timecounter(clkctrl)
+
+    remaining_ms = None
+    if timecounter is not None and current_timecounter is not None:
+        remaining_ms = _timecounter_delta_ms(
+            clkctrl,
+            timecounter - current_timecounter,
+        )
+
+    parts = ["quel_ic_config_timing", f"event={event}"]
+    if elapsed_ms is not None:
+        parts.append(f"elapsed_ms={elapsed_ms:.3f}")
+    if timecounter is not None:
+        parts.append(f"timecounter={timecounter}")
+    if current_timecounter is not None:
+        parts.append(f"current_timecounter={current_timecounter}")
+    if remaining_ms is not None:
+        parts.append(f"remaining_ms={remaining_ms:.3f}")
+    if current_error is not None:
+        parts.append(f"current_timecounter_error={current_error!r}")
+    for key in sorted(fields):
+        value = fields[key]
+        if value is not None:
+            parts.append(f"{key}={_format_value(value)}")
+
+    logger.info(" ".join(parts))
+
+
+def timed_call(
+    logger: Logger,
+    event: str,
+    call: Callable[[], T],
+    *,
+    clkctrl: Any = None,
+    timecounter: Optional[int] = None,
+    current_timecounter: Optional[int] = None,
+    **fields: Any,
+) -> T:
+    """Run a call and log elapsed wall-clock time when diagnostics are enabled."""
+    if not diagnostics_enabled():
+        return call()
+
+    log_timing_event(
+        logger,
+        event,
+        clkctrl=clkctrl,
+        timecounter=timecounter,
+        current_timecounter=current_timecounter,
+        phase="start",
+        **fields,
+    )
+    started = time.perf_counter()
+    try:
+        result = call()
+    except Exception as exc:
+        log_timing_event(
+            logger,
+            event,
+            clkctrl=clkctrl,
+            timecounter=timecounter,
+            current_timecounter=current_timecounter,
+            elapsed_ms=(time.perf_counter() - started) * 1000.0,
+            phase="error",
+            error=f"{type(exc).__name__}: {exc}",
+            **fields,
+        )
+        raise
+    log_timing_event(
+        logger,
+        event,
+        clkctrl=clkctrl,
+        timecounter=timecounter,
+        current_timecounter=current_timecounter,
+        elapsed_ms=(time.perf_counter() - started) * 1000.0,
+        phase="end",
+        **fields,
+    )
+    return result
